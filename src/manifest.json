{
  "manifest_version": 3,
  "name": "dx.block",
  "short_name": "dx.block",
  "description": "Fast, thorough ad blocker: ads, trackers, pop-ups, YouTube ads and malware, using EasyList, uBlock and AdGuard filters.",
  "version": "0.0.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "dx.block",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "scripting",
    "storage",
    "webNavigation",
    "contextMenus",
    "privacy",
    "proxy",
    "webRequestAuthProvider",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/cosmetic.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "redirects/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "commands": {
    "pick-element": {
      "description": "Block an element on this page"
    }
  }
}
